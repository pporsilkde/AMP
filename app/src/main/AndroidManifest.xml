<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.libopenmw.openmw">
    <!-- Allow writing to external storage -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:requestLegacyExternalStorage="true"
        android:name="utils.MyApp"
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="ArenaMP"
        android:theme="@style/ArenaGlass.Launcher"
        android:usesCleartextTraffic="true"
        tools:ignore="GoogleAppIndexingWarning">
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_file_paths" />
        </provider>
        <activity
            android:name="ui.activity.MainActivity"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:label="ArenaMP"
            android:screenOrientation="fullUser">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name="ui.activity.GameActivity"
            android:configChanges="keyboardHidden|orientation"
            android:screenOrientation="sensorLandscape"
            android:windowSoftInputMode="adjustNothing|stateHidden"
            android:theme="@style/Theme.AppCompat.FullScreen" />
        <activity
            android:name="ui.activity.ConfigureControls"
            android:configChanges="keyboardHidden|orientation"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/Theme.AppCompat.FullScreen" />
        <activity
            android:name="ui.activity.HelpActivity"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:screenOrientation="fullUser"
            android:theme="@style/ArenaGlass.Launcher"
            android:label="@string/help_title" />
        <activity
            android:name="ui.activity.GraphicsSettingsActivity"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:screenOrientation="fullUser"
            android:theme="@style/ArenaGlass.Launcher"
            android:label="@string/pref_graphics_settings_title" />
        <activity
            android:name="ui.activity.ModsActivity"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:screenOrientation="fullUser"
            android:theme="@style/ArenaGlass.Launcher"
            android:exported="true"
            android:label="@string/activity_mods"
            />
        <activity
            android:name="server.ServerActivity"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:screenOrientation="fullUser"
            android:theme="@style/ArenaGlass.Launcher"
            android:exported="false"
            android:label="@string/server_title" />
        <service
            android:name="server.ArenaServerService"
            android:process=":arenamp_server"
            android:exported="false"
            android:stopWithTask="false" />
    </application>

</manifest>
