<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ========================================================= -->
    <!-- ArenaMP obsidian-glass palette (Morrowind brass/gold).     -->
    <!-- Единая палитра для всех флейворов и всех системных тем:   -->
    <!-- Тёплые поверхности ближе к desktop Launcher/Wizard.        -->
    <!-- ========================================================= -->

    <!-- Фоны -->
    <color name="bgPrimary">#18191C</color>          <!-- обсидиан -->
    <color name="bgSurface">#202124</color>          <!-- стеклянная тёмная поверхность -->
    <color name="bgSurfaceAlt">#2C2C2E</color>       <!-- поднятая поверхность -->
    <color name="bgDivider">#514C43</color>          <!-- латунно-тёмная обводка -->

    <!-- Акценты (золото, как на дизайне) -->
    <color name="accentGold">#D9B56C</color>         <!-- основные кнопки, активные элементы -->
    <color name="accentGoldDark">#A8844C</color>     <!-- pressed / ripple -->
    <color name="accentGoldMuted">#9C896A</color>    <!-- вторичный латунный акцент -->

    <!-- Текст -->
    <color name="textPrimary">#E8E1D4</color>        <!-- основной текст -->
    <color name="textSecondary">#A39784</color>      <!-- подсказки, hint -->
    <color name="textOnAccent">#18130E</color>       <!-- текст на золотых кнопках -->

    <!-- ========================================================= -->
    <!-- Обратная совместимость: старые имена, используемые в темах -->
    <!-- и в коде. Все ссылаются на новую палитру — layout'ы        -->
    <!-- поштучно перерисовывать не нужно.                          -->
    <!-- ========================================================= -->
    <color name="colorPrimary">@color/accentGold</color>
    <color name="colorPrimaryDark">@color/bgPrimary</color>
    <color name="colorAccent">@color/accentGold</color>

    <!-- Используется в nightly/styles.xml как android:statusBarColor.
         Ранее был не определён — именно этот missing resource
         ломал сборку APK. -->
    <color name="statusBarColor">@color/bgPrimary</color>

    <!-- Mod manager (activity_mods.xml, mod_item.xml) -->
    <color name="modItemBackgroundColor">@color/bgSurface</color>
    <color name="modItemSelectedColor">@color/bgSurfaceAlt</color>

    <!-- Toolbar / action bar -->
    <color name="toolbarBackground">@color/bgSurface</color>
    <color name="toolbarTitle">@color/accentGold</color>
    <color name="toolbarSubtitle">@color/accentGoldMuted</color>

    <!-- Tabs (верхние вкладки в activity_mods) -->
    <color name="tabBackground">@color/bgSurface</color>
    <color name="tabIndicator">@color/accentGold</color>
    <color name="tabTextSelected">@color/accentGold</color>
    <color name="tabTextNormal">@color/accentGoldMuted</color>

    <!-- FAB -->
    <color name="fabBackground">@color/bgSurface</color>
    <color name="fabRipple">@color/accentGoldDark</color>
    <color name="fabShadow">#8020160D</color>
</resources>
