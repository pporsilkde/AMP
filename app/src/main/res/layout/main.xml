<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/arena_glass_backdrop"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/main_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@drawable/arena_glass_card"
        android:layout_margin="8dp"
        android:elevation="4dp"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        app:popupTheme="@style/ThemeOverlay.AppCompat.Dark"
        app:subtitleTextColor="@color/toolbarSubtitle"
        app:titleTextColor="@color/toolbarTitle">

        <Button
            android:id="@+id/btn_changelog"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:minWidth="0dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="@string/arena_changelog_button"
            android:textAllCaps="false"
            android:textColor="@color/toolbarTitle"
            android:textSize="14sp" />

        <!-- globe: opens morrowind.site -->
        <ImageButton
            android:id="@+id/btn_globe"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="end|center_vertical"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/btn_globe_desc"
            android:padding="10dp"
            android:src="@drawable/arena_ic_globe"
            android:tint="@color/toolbarTitle" />

        <!-- download-arrow: triggers update -->
        <ImageButton
            android:id="@+id/btn_update"
            android:visibility="gone"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="end|center_vertical"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/btn_update_desc"
            android:padding="10dp"
            android:src="@drawable/arena_ic_update"
            android:tint="@color/toolbarTitle" />

    </androidx.appcompat.widget.Toolbar>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <FrameLayout
                android:id="@+id/content_frame"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="4"
                android:background="@android:color/transparent" />

            <TextView
                android:id="@+id/fab_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="104dp"
                android:layout_marginBottom="34dp"
                android:text="@string/arena_action_play"
                android:textColor="@color/toolbarTitle"
                android:textSize="16sp" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fab"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|right"
                android:layout_margin="16dp"
                android:src="@drawable/arena_ic_play"
                app:backgroundTint="@color/fabBackground"
                app:borderWidth="0dp"
                app:elevation="8dp"
                app:pressedTranslationZ="0dp"
                app:useCompatPadding="true"
                app:rippleColor="@color/fabRipple"
                app:tint="@color/accentGold" />
        </FrameLayout>
    </LinearLayout>

</LinearLayout>
