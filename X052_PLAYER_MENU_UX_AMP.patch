+    std::string GUIChat::selectedRosterName() const
+    {
+        const std::size_t index = mGroupRoster->getIndexSelected();
+        if (index == MyGUI::ITEM_NONE || index >= groupRosterNames.size())
+            return std::string();
+        return groupRosterNames[index];
+    }
