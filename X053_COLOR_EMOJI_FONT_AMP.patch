+
+    with open(xml_path, 'w', encoding='utf-8') as handle:
+        handle.write('\n'.join(lines))
+
+    glyphs = sum(1 for entry in placed if entry[1] is not None)
+    print("%s: %dx%d, %d glyphs (%d emoji), line height %d"
