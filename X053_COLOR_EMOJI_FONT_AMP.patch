+# X052/X053: font used by the interactive player menu, and font used for the
+# emoji quick-insert palette.
+#
+# Empty "emoji font" keeps the always-renderable ASCII palette (:) <3 xD), which
+# is what stops the quick-insert buttons from showing empty boxes with OpenMW's
+# stock DejaVu LGC face.
+#
+# Set BOTH to ArenaMPChatColor to get full-colour OpenMoji in chat. That font is
+# the generated atlas produced by tools/arenamp_make_emoji_font.py; it carries
+# Latin, Greek and Cyrillic as white glyphs (so #RRGGBB colour tags keep
+# working) plus the emoji with their own colours baked in.
+#
+#   menu font = ArenaMPChatColor
+#   emoji font = ArenaMPChatColor
+#
+# If the named font is not registered, the chat silently falls back to
+# DejaVuLGCSansMono and the ASCII palette, so a missing atlas is never fatal.
+menu font =
 emoji font =
+chat font resource = ArenaMPChatColor.xml
 
 [Equipment Requirements]
 # ArenaMP fallback defaults. The server overwrites every value in this
