/* ArenaMP X058 launcher theme.
   Source artwork: textures.zip supplied by the project owner.
   Applied globally from QApplication so every launcher page/dialog inherits it. */

QMainWindow, QDialog {
    background-color: #6c6d6c;
    background-image: url(:/theme/arenamp-bg.png);
    color: #efe5bf;
}

QWidget {
    color: #efe5bf;
    selection-background-color: #9a8350;
    selection-color: #fff8dc;
}

QWidget#centralwidget, QStackedWidget, QGroupBox, QFrame,
QTabWidget::pane, QScrollArea, QAbstractScrollArea {
    background-color: rgba(37, 35, 29, 218);
}

QLabel {
    background: transparent;
    color: #efe5bf;
}

QPushButton, QToolButton {
    min-height: 24px;
    padding: 4px 10px;
    color: #f5e9bd;
    background-color: #8d7a4f;
    background-image: url(:/theme/arenamp-button-up.png);
    border: 1px solid #b59e6b;
    border-radius: 2px;
}

QPushButton:hover, QToolButton:hover {
    border-color: #d8c78f;
    color: #fff7d6;
}

QPushButton:pressed, QToolButton:pressed,
QPushButton:checked, QToolButton:checked {
    background-color: #6d5e3f;
    background-image: url(:/theme/arenamp-button-down.png);
    border-color: #8f794e;
}

QPushButton:disabled, QToolButton:disabled {
    color: #8f8873;
    border-color: #6b6250;
    background-color: #4d493f;
    background-image: none;
}

QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QDoubleSpinBox,
QComboBox, QListView, QListWidget, QTreeView, QTreeWidget, QTableView,
QTableWidget {
    background-color: rgba(28, 27, 23, 235);
    color: #f1e6c1;
    border: 1px solid #8f7a51;
    border-radius: 2px;
    padding: 3px;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus,
QComboBox:focus, QListView:focus, QTreeView:focus, QTableView:focus {
    border-color: #d1bd7f;
}

QComboBox::drop-down {
    border-left: 1px solid #8f7a51;
    width: 22px;
}

QMenuBar, QMenu, QStatusBar {
    background-color: #34322b;
    color: #efe5bf;
    border-color: #6f6043;
}

QMenuBar::item:selected, QMenu::item:selected {
    background-color: #88764c;
    color: #fff8dc;
}

QTabBar::tab {
    padding: 6px 12px;
    margin-right: 2px;
    color: #d9cfac;
    background-color: #554d3c;
    border: 1px solid #75684b;
}

QTabBar::tab:selected {
    color: #fff3c9;
    background-color: #88764c;
    border-color: #c2ad74;
}

QHeaderView::section {
    padding: 4px;
    color: #f1e6c1;
    background-color: #4b4538;
    border: 1px solid #75684b;
}

QGroupBox {
    border: 1px solid #75684b;
    border-radius: 3px;
    margin-top: 8px;
    padding-top: 6px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 8px;
    padding: 0 4px;
    color: #e7d8a8;
}

QProgressBar {
    border: 1px solid #75684b;
    background-color: #292720;
    color: #fff3c9;
    text-align: center;
}

QProgressBar::chunk {
    background-color: #8e7746;
}

QScrollBar:vertical, QScrollBar:horizontal {
    background-color: #292720;
    border: 1px solid #5f543e;
}

QScrollBar::handle:vertical, QScrollBar::handle:horizontal {
    background-color: #8d7a4f;
    border: 1px solid #b59e6b;
    min-height: 18px;
    min-width: 18px;
}

QToolTip {
    color: #fff3c9;
    background-color: #2c2a24;
    border: 1px solid #b59e6b;
}
